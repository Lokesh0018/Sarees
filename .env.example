# Public site URL (no trailing slash). Used for canonical URLs, Open Graph,
# sitemap.xml, robots.txt and the product link inside WhatsApp enquiries.
VITE_SITE_URL=https://www.example.com

# Where the catalogue JSON files are served from. Defaults to /data (the files
# in public/data). Point this at a future API/CDN without touching components.
VITE_DATA_BASE_URL=/data
